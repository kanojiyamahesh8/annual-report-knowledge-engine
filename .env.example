LLM_PROVIDER=openai
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-2.0-flash
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
# Default corpus: complete 335-page annual report evidence generated by the local extractor.
EVIDENCE_PATH=data/full_evidence.json
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LOG_LEVEL=INFO
